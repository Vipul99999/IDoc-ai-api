                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "budget": {
                    "type": "string",
                    "enum": [
                      "economy",
                      "standard",
                      "premium"
                    ]
                  },
                  "urgency": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "express"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Uploaded document queued for background processing"
          }
        }
      }
    },
    "/api/documents/batch-upload": {
      "post": {
        "summary": "Upload and queue multiple documents for background analysis",
