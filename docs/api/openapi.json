{
  "openapi": "3.1.0",
  "info": {
    "title": "IntelliDoc AI Document Intelligence API",
    "version": "1.0.0",
    "description": "APIs for authentication, upload, background analysis, OCR, translation, formatting, search, billing, monitoring, backups, security, and administration."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local web API"
    },
    {
      "url": "http://localhost:4000",
      "description": "API gateway boundary"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    },
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "summary": "Create a JWT session",
        "tags": ["Authentication"],
        "security": [],
        "responses": {
          "200": {
            "description": "Access token and user profile"
          }
        }
      }
    },
    "/v1/api-keys": {
      "get": {
        "summary": "List API keys for the tenant",
        "tags": ["API Keys"],
        "responses": {
          "200": {
            "description": "API keys without secret material"
          }
        }
      },
      "post": {
        "summary": "Create an API key",
        "tags": ["API Keys"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "scopes": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New API key. The secret is returned once."
          }
        }
      },
      "delete": {
        "summary": "Revoke an API key",
        "tags": ["API Keys"],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Revoked" }
        }
      }
    },
    "/v1/documents": {
      "get": {
        "summary": "List tenant documents",
        "tags": ["Documents"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated document list with standard response envelope"
          }
        }
      },
      "post": {
        "summary": "Upload and queue a document",
        "tags": ["Documents"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "budget": { "type": "string", "enum": ["economy", "standard", "premium"] },
                  "urgency": { "type": "string", "enum": ["normal", "express"] }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Document accepted and queued"
          },
          "415": {
            "description": "Unsupported document type"
          }
        }
      }
    },
    "/v1/jobs/analyze": {
      "post": {
        "summary": "Create a quality analysis and classification job",
        "tags": ["Jobs"],
        "requestBody": {
          "$ref": "#/components/requestBodies/DocumentJobRequest"
        },
        "responses": {
          "202": { "description": "Job accepted" }
        }
      }
    },
    "/v1/jobs/ocr": {
      "post": {
        "summary": "Create an OCR job",
        "tags": ["Jobs"],
        "requestBody": {
          "$ref": "#/components/requestBodies/DocumentJobRequest"
        },
        "responses": {
          "202": { "description": "OCR job accepted" }
        }
      }
    },
    "/v1/jobs/translate": {
      "post": {
        "summary": "Create a translation job",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["document_id", "target_language"],
                "properties": {
                  "document_id": { "type": "string", "format": "uuid" },
                  "target_language": { "type": "string", "example": "hi" },
                  "source_language": { "type": "string", "example": "en" },
                  "preserve_layout": { "type": "boolean", "default": true },
                  "glossary": { "type": "object", "additionalProperties": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Translation job accepted" }
        }
      }
    },
    "/v1/jobs/reformat": {
      "post": {
        "summary": "Create a layout cleanup job",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["document_id"],
                "properties": {
                  "document_id": { "type": "string", "format": "uuid" },
                  "format": { "type": "string", "enum": ["pdf", "docx", "pptx"], "default": "pdf" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Reformat job accepted" }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Get job status",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Job status" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/results/{id}": {
      "get": {
        "summary": "Get document intelligence results",
        "tags": ["Results"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Analysis, OCR, extraction, translation, formatting, and generated outputs" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/search": {
      "get": {
        "summary": "Full-text and semantic search",
        "tags": ["Search"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Ranked search hits" }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get metered usage records and totals",
        "tags": ["Usage"],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 500 } }
        ],
        "responses": {
          "200": { "description": "Usage records and meter totals" }
        }
      }
    },
    "/v1/billing/invoices": {
      "get": {
        "summary": "List invoices",
        "tags": ["Billing"],
        "responses": {
          "200": { "description": "Invoice list" }
        }
      }
    },
    "/v1/billing/subscription": {
      "get": {
        "summary": "Get subscription and available plans",
        "tags": ["Billing"],
        "responses": {
          "200": { "description": "Subscription, plan, and period usage data" }
        }
      }
    },
    "/v1/webhooks": {
      "post": {
        "summary": "Create a webhook endpoint",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "events": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["job.completed", "job.failed", "quota.threshold_reached", "invoice.generated"] }
                  },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook endpoint and signing secret" }
        }
      }
    },
    "/api/documents": {
      "get": {
        "summary": "List documents",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
